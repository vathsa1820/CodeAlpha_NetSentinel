# =============================================================================
# NetSentinel Custom Snort Rules
# Phase 2 — Snort Configuration
# =============================================================================
# These rules are designed for controlled lab/internship demonstration.
# Each rule targets a specific threat category at an appropriate severity.
# =============================================================================

# -----------------------------------------------------------------------------
# Rule 1 — ICMP Activity (LOW severity)
# Detects any ICMP packet on the network.
# -----------------------------------------------------------------------------
alert icmp any any -> any any (msg:"[NetSentinel] ICMP Activity Detected"; classtype:network-scan; sid:9000001; rev:1;)

# -----------------------------------------------------------------------------
# Rule 2 — Suspicious TCP Connection Attempt (MEDIUM severity)
# Detects a TCP SYN packet to port 4444.
# -----------------------------------------------------------------------------
alert tcp any any -> $HOME_NET 4444 (msg:"[NetSentinel] Suspicious TCP Connection Attempt on Port 4444"; flags:S; classtype:attempted-recon; sid:9000002; rev:1;)

# -----------------------------------------------------------------------------
# Rule 3 — Suspicious HTTP Request (HIGH severity)
# Detects an HTTP GET request containing the harmless test string "netsentinel-test" in the URI.
# -----------------------------------------------------------------------------
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"[NetSentinel] Suspicious HTTP Test Pattern Detected"; flow:to_server,established; content:"netsentinel-test"; http_uri; classtype:web-application-attack; sid:9000003; rev:1;)
